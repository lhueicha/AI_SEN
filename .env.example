# ============================================================================
# AI SEN — variables de entorno
#
#   cp .env.example infra/.env     y rellena los valores
#
# infra/.env NUNCA se sube a git ni se monta en el contenedor de Caddy.
# ============================================================================

# --- Dominio (solo producción) ----------------------------------------------
# De prueba, gratis y con HTTPS real:
DOMAIN=145-223-92-190.sslip.io

# --- Motor (FreeLLMAPI) -----------------------------------------------------
# Clave unificada del motor. Panel del motor → Keys.
# SECRETA: quien la tenga usa tu motor y tu cuota.
ENGINE_KEY=freellmapi-...

# --- Supabase ---------------------------------------------------------------
# Panel de Supabase → Project Settings → API
SUPABASE_URL=https://nqonojwcvmhzwxqsqffd.supabase.co

# SECRETA: salta todas las políticas RLS. Solo en el servidor.
SUPABASE_SERVICE_KEY=sb_secret_...

# Pública por diseño: va en web/config.js, la limitan las políticas RLS.
SUPABASE_ANON_KEY=sb_publishable_...

# --- Aprovisionamiento del motor (solo para infra/provision-engine.mjs) -----
# El script crea la cuenta admin y carga estas claves en el motor.
# Después puedes borrarlas de aquí: quedan cifradas dentro del motor.
ADMIN_EMAIL=tu@correo.com
ADMIN_PASSWORD=una-contrasena-larga
OPENROUTER_KEY=sk-or-v1-...
GROQ_KEY=gsk_...
GOOGLE_KEY=AQ...
